{
  "name": "ahwr-ui-tests",
  "version": "0.0.1",
  "description": "Automated tests for AHWR services",
  "type": "module",
  "engines": {
    "npm": ">=11.10.0"
  },
  "scripts": {
    "test:mainSuite": "wdio run wdio.conf.js --suite mainSuite",
    "test:comp": "wdio run wdio.conf.js --suite comp",
    "test:compFA": "wdio run wdio.conf.js --suite compFA",
    "test:accessibility": "wdio run wdio.conf.js --suite accessibility",
    "test:compatibility": "wdio run wdio.browserstack.conf.js --suite compatibility",
    "lint": "prettier . --check && eslint",
    "lint:fix": "prettier . --write && eslint --fix",
    "hooks": "cp -r hooks/. .git/hooks/ && chmod -R +x .git/hooks && echo 'hooks copied'"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DEFRA/ahwr-ui-tests.git"
  },
  "author": "Defra",
  "contributors": [
    "Rob Catton rob.catton@defra.gov.uk",
    "Berlin Bernadin berlin.bernadin@defra.gov.uk"
  ],
  "license": "OGL-UK-3.0",
  "bugs": {
    "url": "https://github.com/DEFRA/ahwr-ui-tests/issues"
  },
  "homepage": "https://github.com/DEFRA/ahwr-ui-tests#readme",
  "dependencies": {
    "@axe-core/webdriverio": "^4.13.0",
    "@wdio/allure-reporter": "9.30.1",
    "@wdio/browserstack-service": "^9.33.0",
    "@wdio/cli": "9.30.1",
    "@wdio/local-runner": "9.30.1",
    "@wdio/mocha-framework": "9.30.1",
    "@wdio/spec-reporter": "9.30.1",
    "axe-html-reporter": "^2.2.11"
  },
  "devDependencies": {
    "allure-commandline": "2.43.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-sonarjs": "4.2.0",
    "husky": "^9.1.7",
    "nano-staged": "^1.0.2",
    "neostandard": "^0.13.0",
    "prettier": "^3.9.6"
  },
  "nano-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
